# Copy to .env and fill in real values. See src/server/config/env.ts for validation rules.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Used by docker-compose.yml to configure the postgres service. Also used
# below to build DATABASE_URL for `npm run dev` against the same container
# (its port is published to the host).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=btc_investment

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/btc_investment
REDIS_URL=redis://localhost:6379

# Signs/verifies access tokens (see ADR-0003, issue #20). Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# Optional: override the host ports docker-compose.yml publishes postgres/redis
# on (e.g. if 5432/6379 are already taken locally). Update DATABASE_URL/
# REDIS_URL above to match if you do.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
