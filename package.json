{
  "name": "btc-investment-api",
  "version": "1.0.0",
  "description": "BTC Investment API",
  "type": "module",
  "main": "dist/server/index.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --env-file-if-exists=.env node_modules/.bin/vitest run",
    "test:watch": "node --env-file-if-exists=.env node_modules/.bin/vitest",
    "db:generate": "node --env-file-if-exists=.env node_modules/.bin/prisma generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/.bin/prisma migrate dev",
    "db:migrate:deploy": "node --env-file-if-exists=.env node_modules/.bin/prisma migrate deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardoximenes/btc-investment-api.git"
  },
  "author": "Eduardo Ximenes",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/eduardoximenes/btc-investment-api/issues"
  },
  "homepage": "https://github.com/eduardoximenes/btc-investment-api#readme",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "typedi": "^0.10.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
